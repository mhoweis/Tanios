# Copy this file to .env on the server and fill it in. Never commit .env.

# The web address that points at this server, without https://
TANIOS_DOMAIN=tanios.example.com

# Database password. Letters and digits only. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- WhatsApp (milestone 1). docs/SETUP-WHATSAPP.md says where each value comes from. ---

# Any long random text you invent. You type the same text into Meta's webhook form.
#   openssl rand -hex 24
TANIOS_WHATSAPP_VERIFY_TOKEN=

# Meta dashboard: App settings, Basic, App secret.
TANIOS_WHATSAPP_APP_SECRET=

# Meta dashboard: WhatsApp, API Setup. The permanent token of your system user.
TANIOS_WHATSAPP_ACCESS_TOKEN=

# Meta dashboard: WhatsApp, API Setup, "Phone number ID" (not the phone number itself).
TANIOS_WHATSAPP_PHONE_NUMBER_ID=

# Your own WhatsApp number with country code, digits only. Example: 962790000001
TANIOS_OWNER_NUMBER=

# --- Models and budget (milestones 1 and 2). See docs/MODELS-AND-BUDGET.md ---

# openrouter.ai, Keys, Create key.
TANIOS_OPENROUTER_API_KEY=

# The most Tanios may spend on models in a calendar month, in US dollars.
# Example: 5 means five dollars. Leave empty for no cap.
TANIOS_MONTHLY_CAP_USD=5

# May free models see your email, notes and files? Free models can come with
# data-use terms, so the safe answer is false.
TANIOS_ALLOW_FREE_FOR_PRIVATE=false

# --- Memory (milestone 4). See docs/MEMORY.md ---

# Your time zone, for the dates on notes and the daily log. Examples: Asia/Amman,
# Europe/London, America/New_York.
TANIOS_TIMEZONE=UTC

# Add the line below only after finishing part 2 of docs/MEMORY.md (Obsidian Sync).
# COMPOSE_PROFILES=sync

# Keys for other providers, if you add any to the models file. The part after
# TANIOS_KEYS__ is the provider's name there.
# TANIOS_KEYS__DEEPSEEK=
